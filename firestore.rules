rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin helper
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'alqasmhapip468@gmail.com' ||
        request.auth.uid == 'superadmin'
      );
    }

    // Health / Connection Check Path
    match /system/{docId} {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Partner Applications Collection
    match /partner_applications/{appId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
