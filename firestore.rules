rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin helper
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'alqasmhapip468@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']
      );
    }

    // Health / Connection Check Path
    match /system/{docId} {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;

      allow create: if request.auth != null && (
        isAdmin() || request.auth.uid == userId
      );

      allow update: if request.auth != null && (
        isAdmin() || request.auth.uid == userId
      );

      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Company Requests Collection
    match /companyRequests/{requestId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Partner Applications Collection
    match /partner_applications/{appId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
