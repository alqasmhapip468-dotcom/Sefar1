rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global rule for platform collections
    match /{document=**} {
      allow read, write: if true;
    }

    // Health / Connection Check Path
    match /system/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Company Requests Collection
    match /companyRequests/{requestId} {
      allow read, write: if true;
    }

    // Partner Applications Collection
    match /partner_applications/{appId} {
      allow read, write: if true;
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read, write: if true;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read, write: if true;
    }
  }
}
